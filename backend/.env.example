# VeriSketch AI backend configuration. Copy to backend/.env and edit.
# backend/.env is git-ignored. Never commit real credentials.

# Where sketches (SQLite + images) are stored. Default: backend/data
# VERISKETCH_DATA_DIR=

# ---- Optional hosted AI provider (off by default) ----------------------------
# Usage may be billed by Google. Check your own quota and pricing first.
# VERISKETCH_HOSTED_PROVIDER=gemini
# GEMINI_API_KEY=your-key-here
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# VERISKETCH_HOSTED_TIMEOUT=90

# ---- Optional local model (detection only in this build) ---------------------
# VERISKETCH_LOCAL_MODEL_PATH=/path/to/a/local/diffusers/model

# Max reference-image upload size in MB (default 5)
# VERISKETCH_MAX_UPLOAD_MB=5
